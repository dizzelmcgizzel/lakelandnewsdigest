# ==============================================================================
# Lakeland TN News Digest - Environment Configuration
# Copy this file to '.env' and fill in your email credentials.
# ==============================================================================

# SMTP Provider Settings (Default is Google / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your Gmail address (or SMTP username)
SMTP_USER=your_email@gmail.com

# For Gmail, use a 16-character Google App Password (NOT your regular password).
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx

# Sender Details
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=Lakeland TN News Digest

# Where the news digest should be sent
RECIPIENT_EMAIL=your_email@gmail.com
